//-----------------------------------------------------------------------------
//	SHADEREMPTY.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
	$Compiler
	{
		// "..\" is a Windows relative path that the generator does not
		// translate, so shaderapiempty.cpp's bare includes of
		// IHardwareConfigInternal.h and shadersystem.h (both in materialsystem/)
		// were unresolvable. The dedicated server loads this module at runtime
		// through CMaterialSystem::SetShaderAPI("shaderapiempty"), so spell the
		// module directory out. Same fix as materialsystem/shaderlib.
		$AdditionalIncludeDirectories		"$BASE;..\;$SRCDIR\materialsystem"
		$PreprocessorDefinitions			"$BASE;SHADER_DLL_EXPORT;PROTECTED_THINGS_ENABLE"
	}

	$Linker
	{
		$AdditionalDependencies				"$BASE odbc32.lib odbccp32.lib"
		$SystemLibraries                                                        "iconv" [$OSXALL]
	}
}

$Project "shaderapiempty"
{
	$Folder	"Source Files"
	{
		$File	"shaderapiempty.cpp"
	}

	$Folder	"Header Files"
	{
		$File	"$SRCDIR\public\tier0\platform.h"
	}
}
