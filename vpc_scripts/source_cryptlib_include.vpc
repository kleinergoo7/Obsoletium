//-----------------------------------------------------------------------------
// SOURCE_CRYPTLIB_INCLUDE.VPC
//
// Includes needed to link cryptopp
//
//-----------------------------------------------------------------------------


$Project
{	
	$Folder	"Source Files"
	{
		$File	"$SRCDIR\common\crypto.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}
	}

	$Folder	"Link Libraries" 
	{
		$Lib	vpklib
		$Libexternal $SRCDIR\thirdparty\libcrypto [$OSXALL]
		$Libexternal $SRCDIR\thirdparty\libcryptopp [$OSXALL]

		// Linux port: the two LINUXALL $Libexternal entries that used to be
		// here named prebuilts that do not exist in this tree:
		//   $Libexternal "$SRCDIR\thirdparty\$(CRYPTOPPDIR)\libcryptopp" [$LINUXALL]
		// CRYPTOPPDIR is defined by no script in the repository, so the path
		// expanded to a literal "$(CRYPTOPPDIR)", the generator could not
		// quote it, and the link silently vanished. common/crypto.cpp -- added
		// by this same nameless $Project -- then referenced CryptoPP with
		// nothing behind it and startup aborted with:
		//   open libfilesystem_stdio.so failed: libfilesystem_stdio.so: undefined
		//   symbol: _ZNK8CryptoPP21KeyDerivationFunction19MinDerivedKeyLengthEv
		// thirdparty/cryptopp/cryptopp.vpc now builds the vendored sources
		// (CRYPTOPP_VERSION 890) into the libcryptopp module this port needs.
		$Lib cryptopp [$LINUXALL]

		// No libcrypto on Linux: the only OpenSSL use in common/crypto.cpp is
		// behind USE_OPENSSL_AES_DECRYPT, which is only defined by
		// ENABLE_OPENSSLCONNECTION. Neither is set by any .vpc in this tree, so
		// openssl/aes.h is never included and the AES paths below it do not
		// compile. Everything resolves inside CryptoPP instead.
	}

	$Folder "Link Libraries" [$WINDOWS]
	{
		$File "$SRCDIR\thirdparty\cryptopp\Win32\Output\Release\cryptlib.lib" [$WIN32]
		{
			$Configuration "Debug" 	{ $ExcludedFromBuild "Yes" }
		}
		$File "$SRCDIR\thirdparty\cryptopp\Win32\Output\Debug\cryptlib.lib" [$WIN32]
		{
			$Configuration "Release" { $ExcludedFromBuild "Yes" }
		}
		
		$File "$SRCDIR\thirdparty\cryptopp\x64\Output\Release\cryptlib.lib" [$WIN64]
		{
			$Configuration "Debug" 	{ $ExcludedFromBuild "Yes" }
		}
		$File "$SRCDIR\thirdparty\cryptopp\x64\Output\Debug\cryptlib.lib" [$WIN64]
		{
			$Configuration "Release" { $ExcludedFromBuild "Yes" }
		}
	}
}
